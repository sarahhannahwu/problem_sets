library(tidyverse)
library(here)
library(janitor)
library(metafor)
d <- read_csv(here("data","Study1A_prepared.csv"))
d <- janitor::clean_names(d)
names(d)
unique(d$panel)
sunk_means <- d |>
group_by(...) |>
summarise(...)
View(d)
sunk_means <- d |>
group_by(panel) |>
summarise(num_sunk_cost)
sunk_means <- d |>
group_by(panel) |>
summarize(mean_sunk_cost = mean(num_sunk_cost))
sunk_means
library(rstatix)
sunk_means <- d |>
group_by(panel) |>
get_summary_stats(num_sunk_cost, type="mean_se")
sunk_means
ggplot(sunk_means, aes(x=panel, y=mean)) +
geom_point() +
geom_errorbar(aes(ymin=mean-se, ymax=mean+se))
ggplot(sunk_means, aes(x=panel, y=mean)) +
geom_point() +
geom_errorbar(aes(ymin=mean-se, ymax=mean+se)) +
ylim(c(1, 9))
