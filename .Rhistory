geom_boxplot()
...
install.packages("ggdist")
library(ggdist)
ggplot(df, aes(x = as.factor(bnt), y = num_sunk_cost, fill = as.factor(bnt))) +
# Half violin (density)
stat_halfeye(
adjust = 0.5,
width = 0.6,
.width = 0,
justification = -0.3,
point_colour = NA
) +
# Boxplot
geom_boxplot(
width = 0.2,
outlier.shape = NA,
alpha = 0.5
) +
# Jittered points ("rain")
geom_jitter(
width = 0.1,
alpha = 0.3
) +
theme_minimal() +
theme(legend.position = "none")
